# Fill in and export before deploying

# AWS (optional — CDK CLI can infer account/region from your profile)
# CDK_DEFAULT_ACCOUNT=123456789012
# CDK_DEFAULT_REGION=us-east-1

# CodePipeline — GitHub source via CodeStar Connections
# Create a connection in AWS Console: Developer Tools → Connections
# GITHUB_CONNECTION_ARN=arn:aws:codestar-connections:us-east-1:123456789012:connection/abc123
# GITHUB_OWNER=your-org-or-username
# GITHUB_REPO=user-confirm-lambda-trigger
# GITHUB_BRANCH=main

# Cognito
# COGNITO_USER_POOL_NAME=user-confirm-pool

# Deploy backend stack directly without the pipeline:
# DEPLOY_BACKEND_ONLY=true npx cdk deploy UserConfirmBackendStack
